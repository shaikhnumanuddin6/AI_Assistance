OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=180

# Bind to 127.0.0.1 for local-only use. For Tailscale, bind to this PC's
# Tailscale IPv4 address and allow the API port only from trusted tailnet peers.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# Generate a unique secret locally; never commit or share it in source control.
API_AUTH_TOKEN=